PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose this key to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Session pooler (IPv4) connection, password URL-encoded. Used only for migrations: npx supabase db push --db-url "$DATABASE_URL"
DATABASE_URL=postgresql://postgres.your-project-ref:your-url-encoded-password@aws-0-your-region.pooler.supabase.com:5432/postgres
