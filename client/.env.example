# Supabase → Project Settings → API (the anon key is safe to expose)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Leave empty: in dev Vite proxies /api to localhost:5000, and on Vercel the API is on the same domain.
# Only set it if the API is hosted on a different domain.
VITE_API_URL=

# Show the "Continue with Google" button (enable Google in Supabase Auth first)
VITE_ENABLE_GOOGLE=false
